{
  "name": "mundocelular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "seed:config": "tsx scripts/seed-config.ts",
    "set:admin": "tsx scripts/set-admin.ts",
    "deploy:firestore": "firebase deploy --only firestore --project mundocelular-id",
    "deploy:rules": "firebase deploy --only firestore:rules --project mundocelular-id",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project mundocelular-id"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@lhci/cli": "^0.14.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
