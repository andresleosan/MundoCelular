    "r2:cors": "tsx scripts/config-r2-cors.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "deploy:firestore": "firebase deploy --only firestore --project mundocelular-id",
    "deploy:rules": "firebase deploy --only firestore:rules --project mundocelular-id",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project mundocelular-id"
  },
  "dependencies": {
